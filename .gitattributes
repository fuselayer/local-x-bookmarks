# Windows is the primary dev host here. Without normalisation a fresh clone on
# a machine with a different core.autocrlf shows every file as modified.
* text=auto

# cmd.exe misparses an LF-only batch file, emitting spurious "not recognized"
# errors and sometimes executing the wrong fragment. This one is not cosmetic.
*.cmd text eol=crlf

# Binary assets: never diff, never normalise.
*.png  binary
*.ico  binary
*.icns binary
*.woff2 binary
*.sqlite binary
